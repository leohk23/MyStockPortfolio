node_modules/

# Master source of truth. Contains trade log, rationale, and account detail.
# Never publish to a public repo — the app only ever gets derived data.
*.xlsx
*.xls
*.xlsm
~$*

# Agent lane run artefacts — transient, regenerated every run.
pot/run-log.txt
pot/last-message.txt
pot/sweeps/_*

# Run ledger is regenerated from session logs, not hand-kept.
pot/runs.md

# Derived from session logs and the data files; regenerate with npm run pot-report.
pot/SUMMARY.md
pot/summaries/
pot/logs/
pot/scan.md

# Saved article text is other people's copyrighted work, most of it subscriber-only.
# This repo is public, so the full text stays on Leo's machine and never leaves it.
# reading.md is kept: the citations and the "Why" lines are his own notes, and the Sweep
# needs them. The articles themselves are read locally by whichever agent is running.
pot/reading/*.md
!pot/reading/README.md
