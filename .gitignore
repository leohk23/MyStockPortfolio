node_modules/

# Master source of truth. Contains trade log, rationale, and account detail.
# Never publish to a public repo — the app only ever gets derived data.
*.xlsx
*.xls
*.xlsm
~$*

# Agent lane run artefacts — transient, regenerated every run.
pot/run-log.txt
pot/last-message.txt
pot/sweeps/_*

# Run ledger is regenerated from session logs, not hand-kept.
pot/runs.md
pot/paper.md

# Derived from session logs and the data files; regenerate with npm run pot-report.
pot/SUMMARY.md
pot/summaries/
pot/logs/
pot/scan.md

# Saved article text is other people's copyrighted work and this repo is public, so the
# default is OFF: the text stays on Leo's machine and the agent reads it locally.
# reading.md is always published - the citations and the "Why" lines are his own notes,
# and the Sweep needs them to know what he rates and why.
#
# Publishing one anyway is his call, per file: add a "!" line below and commit it.
pot/reading/*.md
!pot/reading/README.md
!pot/reading/2026-04-14-Convexity-Ivan-Li.md
.daily-lock
